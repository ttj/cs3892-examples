/-
  Session 20 -- session 11's mutex, translated from SMV (S20/Mutex.lean, generated by
  scripts/smv2lean from smv/mutex.smv), and mutual exclusion proved in Lean.

  The proof is a case split. Before the step, (a, b) is one of 3 × 3 = 9 pairs; `cases a <;>
  cases b` makes one goal for each, and `simp` puts each pair's values into the step's
  if-chains. (critical, critical) is ruled out by the invariant itself. In the other eight, the
  step would have to end with both critical, and it cannot: either a guard fails
  (`b != critical` keeps a out while b is in), or both processes would have to move at once,
  which needs move = 1 and move = 2 together.

  Here mutual exclusion is inductive on its own, so no strengthening is needed. (For a
  protocol where it is not -- Peterson-style flags and a turn variable -- see
  VerifDemo/NuXMV/MutexProofs.lean in github.com/ttj/leansmv.)
-/
import S20.Mutex

namespace S20
open AVal BVal

-- SLIDE: mutex-proof
/-- INVARSPEC !(crit_a & crit_b): never both critical. -/
theorem mutual_exclusion : Invariant MutexTS
    (fun s => ¬(s.a = .critical ∧ s.b = .critical)) := by
  apply inductive_invariant_holds
  constructor
  · intro s ⟨ha, _⟩ ⟨hac, _⟩      -- initially a is idle
    rw [ha] at hac
    cases hac
  · intro ⟨a, b, move⟩ t hs ⟨_, _, ha, hb⟩ ⟨hta, htb⟩
    cases a <;> cases b <;> simp at hs ha hb
    all_goals simp_all
-- END

end S20
