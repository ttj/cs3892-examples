/-
  Session 20 -- the two-mode counter, translated from SMV (S20/Counter.lean, generated by
  scripts/smv2lean from smv/counter.smv), and its three INVARSPECs settled in Lean.

  The translator turns each `case ... esac` into an if-then-else chain, one branch per case
  line. So a proof about "every step" splits the same way the SMV did: `split at hx` gives one
  goal per line of next(x)'s case. Splitting on the state's variables instead (`cases mode`,
  `cases press`) gives one goal per combination of them, and some of those goals are closed by
  a contradiction: the step they describe cannot lead where the goal says it went.

  NuSMV says the third INVARSPEC is false and prints a trace to x = 10. In Lean, "false" is a
  theorem too, its negation, and its proof builds that trace one `Reachable.step` at a time.
-/
import S20.Counter

namespace S20
open ModeVal

-- SLIDE: inv1
/-- INVARSPEC x <= count_max: one goal per line of next(x)'s `case`. -/
theorem CounterTS_inv1 : Invariant CounterTS (fun s => s.x ≤ 10) := by
  apply inductive_invariant_holds
  constructor
  · intro s ⟨_, hx⟩                -- initially x = 0
    omega
  · intro s t hs ⟨_, _, _, hx⟩     -- hx: next(x)'s if-chain
    split at hx
    · omega                         -- on & !press & x < 10 : x + 1
    · split at hx
      · omega                       -- on & (press | x >= 10) : 0
      · omega                       -- TRUE : x
-- END

-- SLIDE: inv2
/-- INVARSPEC (mode = off) -> (x = 0): one goal per (mode, press). -/
theorem CounterTS_inv2 :
    Invariant CounterTS (fun s => s.mode = .off → s.x = 0) := by
  apply inductive_invariant_holds
  constructor
  · intro s ⟨_, hx⟩ _
    exact hx
  · intro ⟨mode, press, x⟩ t hs ⟨_, _, hm, hx⟩ ht
    cases mode <;> cases press <;> simp at hs hm hx
    · omega                       -- off, no press: x held
    · rw [ht] at hm; cases hm     -- off, press: turns on
    · split at hm                 -- on, no press:
      · rw [ht] at hm; cases hm   --   x < 10: stays on
      · simp_all                  --   x ≥ 10: off, x := 0
    · exact hx                    -- on, press: off, x := 0
-- END

-- SLIDE: inv3
/-- On, and counted up to k: reachable for every k ≤ 10 (press, then k steps). -/
theorem reach_on : ∀ k, k ≤ 10 → Reachable CounterTS ⟨.on, false, k⟩
  | 0, _ => .step (s := ⟨.off, true, 0⟩) (.init ⟨rfl, rfl⟩) ⟨false, rfl, by simp, by simp⟩
  | k + 1, hk => .step (reach_on k (by omega)) ⟨false, rfl, by simp; omega, by simp; omega⟩

/-- INVARSPEC x < count_max is FALSE: NuSMV's trace, as a proof. -/
theorem CounterTS_inv3_false : ¬ Invariant CounterTS (fun s => s.x < 10) := by
  intro h
  have := h _ (reach_on 10 (by omega))
  simp at this
-- END

end S20
