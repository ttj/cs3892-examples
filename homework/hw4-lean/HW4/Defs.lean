/-! ## Part 1's definitions -/

/-- Three times `n`, the long way. -/
def triple : Nat → Nat
  | 0 => 0
  | n + 1 => triple n + 3

inductive Light where
  | red | amber | green
deriving DecidableEq, Repr

/-- One phase of a traffic light. -/
def Light.next : Light → Light
  | .red => .green
  | .green => .amber
  | .amber => .red

/-! ## Transition systems

A transition system over a type of states: which states are initial, and which
pairs of states are steps. `Reachable` is the least set containing the initial
states and closed under steps -- an *inductive* predicate, so a fact about every
reachable state is proved by induction on how the state was reached. -/

structure TS (State : Type) where
  init : State → Prop
  step : State → State → Prop

inductive Reachable {State : Type} (ts : TS State) : State → Prop
  | init {s} : ts.init s → Reachable ts s
  | step {s t} : Reachable ts s → ts.step s t → Reachable ts t

/-- `P` holds in every initial state, and every step from a `P` state lands in a
    `P` state -- from ANY `P` state, reachable or not. -/
def InductiveInvariant {State : Type} (ts : TS State) (P : State → Prop) : Prop :=
  (∀ s, ts.init s → P s) ∧ (∀ s t, P s → ts.step s t → P t)

/-- `P` holds in every reachable state. -/
def Invariant {State : Type} (ts : TS State) (P : State → Prop) : Prop :=
  ∀ s, Reachable ts s → P s

/-- The inductive-invariant principle (sessions 9 and 20): inductive implies invariant. -/
theorem inductive_invariant_holds {State : Type} (ts : TS State) (P : State → Prop)
    (h : InductiveInvariant ts P) : Invariant ts P := by
  intro s hs
  induction hs with
  | init hi => exact h.1 _ hi
  | step _ hst ih => exact h.2 _ _ ih hst

/-! ## Sets as predicates

A set of `α`s is a predicate on `α`: `x ∈ A` means `A x`. (Mathlib's `Set` is the
same idea; this file defines its own so HW4 needs nothing beyond core Lean.) -/

def Set (α : Type) : Type := α → Prop

namespace Set
variable {α : Type}

instance : Membership α (Set α) := ⟨fun A x => A x⟩

theorem mem_def (x : α) (A : Set α) : (x ∈ A) = A x := rfl

def subset (A B : Set α) : Prop := ∀ x, x ∈ A → x ∈ B
def union (A B : Set α) : Set α := fun x => x ∈ A ∨ x ∈ B
def inter (A B : Set α) : Set α := fun x => x ∈ A ∧ x ∈ B
def diff  (A B : Set α) : Set α := fun x => x ∈ A ∧ ¬ x ∈ B
def compl (A : Set α) : Set α := fun x => ¬ x ∈ A

instance : HasSubset (Set α) := ⟨subset⟩
instance : Union (Set α) := ⟨union⟩
instance : Inter (Set α) := ⟨inter⟩
instance : SDiff (Set α) := ⟨diff⟩
postfix:max "ᶜ" => compl

@[simp] theorem mem_union (x : α) (A B : Set α) : (x ∈ A ∪ B) = (x ∈ A ∨ x ∈ B) := rfl
@[simp] theorem mem_inter (x : α) (A B : Set α) : (x ∈ A ∩ B) = (x ∈ A ∧ x ∈ B) := rfl
@[simp] theorem mem_diff  (x : α) (A B : Set α) : (x ∈ A \ B) = (x ∈ A ∧ ¬ x ∈ B) := rfl
@[simp] theorem mem_compl (x : α) (A : Set α) : (x ∈ Aᶜ) = (¬ x ∈ A) := rfl
theorem subset_def (A B : Set α) : (A ⊆ B) = (∀ x, x ∈ A → x ∈ B) := rfl

/-- Two sets are equal when they have the same members (extensionality). -/
theorem ext {A B : Set α} (h : ∀ x, x ∈ A ↔ x ∈ B) : A = B :=
  funext fun x => propext (h x)

end Set

/-! ## The token bucket (Parts 3 and 4)

A rate limiter for an agent's tool calls: a bucket holds `N` tokens; each action
spends one; when the bucket is empty it is refilled. `used` counts the actions
in the current window, `left` the tokens still in the bucket.

    act    [left > 0]  /  used := used + 1, left := left - 1
    idle               /  (nothing changes)
    refill [left = 0]  /  used := 0, left := N
-/

structure Bucket where
  used : Nat
  left : Nat
deriving DecidableEq, Repr

inductive BucketStep (N : Nat) : Bucket → Bucket → Prop
  | act    {u l : Nat} : l > 0 → BucketStep N ⟨u, l⟩ ⟨u + 1, l - 1⟩
  | idle   {b : Bucket} : BucketStep N b b
  | refill {u : Nat} : BucketStep N ⟨u, 0⟩ ⟨0, N⟩

def bucket (N : Nat) : TS Bucket where
  init b := b.used = 0 ∧ b.left = N
  step := BucketStep N

/-- The instance with a capacity of 10 tokens (Part 3). -/
def bucket10 : TS Bucket := bucket 10

-- Unfolding the bucket: `simp only [bucket10_eq, bucket_init, bucket_step] at h` turns
-- `bucket10.step b c` into `BucketStep 10 b c`, which `cases` can then split.
theorem bucket10_eq : bucket10 = bucket 10 := rfl
@[simp] theorem bucket_init (N : Nat) (b : Bucket) :
    (bucket N).init b = (b.used = 0 ∧ b.left = N) := rfl
@[simp] theorem bucket_step (N : Nat) (b c : Bucket) :
    (bucket N).step b c = BucketStep N b c := rfl

/-- Part 3's property: at most 10 actions in a window. -/
def P (b : Bucket) : Prop := b.used ≤ 10

/-- The obvious strengthening (Part 3b). -/
def Q (b : Bucket) : Prop := b.used ≤ 10 ∧ b.left ≤ 10

end HW4
